      <data key="d4">8.0</data>
      <data key="d5">"Contrastive Learning is an alternative method that learns compressed representations by creating information bottlenecks in the data representation process."</data>
      <data key="d6">chunk-114ad13da3f029831d24b941874b57f7</data>
      <data key="d7">1</data>
    </edge>
    <edge source="&quot;CONTRASTIVE LEARNING&quot;" target="&quot;REPRESENTATION LEARNING&quot;">
      <data key="d4">6.0</data>
